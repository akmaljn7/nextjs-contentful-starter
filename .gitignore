agenthub/agents/youtube/db

# Archive files and large assets
**/*.zip
**/*.tar.gz
**/*.tar
**/*.tgz
*.pack
*.deb
*.dylib

# Build caches
.cache/

memory/test_credentials.md

# Mobile development
android-sdk/
# Secrets — never commit
backend/.env
frontend/.env

# NOTE: mobile/config/google-services.json + GoogleService-Info.plist are
# COMMITTED intentionally. Per Firebase docs, these client-side config files
# only carry package-restricted API keys and are safe to ship in source control.
# The Firebase Admin private key (backend/.env FCM_SERVICE_ACCOUNT_JSON) stays
# git-ignored above and never touches the repo.
.env
.env.*
*.env
credentials.json
*.key
.credentials
